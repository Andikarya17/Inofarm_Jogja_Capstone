# Contoh env untuk server pilot. Salin menjadi .env di server lalu isi nilainya di sana.
# Jangan menyalin .env laptop, dan jangan commit berkas .env yang sudah berisi nilai.

APP_NAME=Inofarm
APP_ENV=production
# Buat di server dengan `php artisan key:generate`. Jangan diganti setelah ada data: sesi dan data terenkripsi ikut tidak terbaca.
APP_KEY=
APP_DEBUG=false
# Wajib HTTPS; APK rilis menolak http.
APP_URL=https://
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
# Akun khusus aplikasi dengan hak hanya pada satu database di atas, bukan root.
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=file
# API memakai token Sanctum; driver sesi hanya untuk kerangka Laravel.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
LOG_LEVEL=warning

# G4, keputusan pilot 14 November 2026: sesi login 7 hari. Bawaan kode 86400 (24 jam).
FINANCE_SESSION_SECONDS=604800

# Q07, nilai pilot 14 November 2026, bukan keputusan produksi: JPG, PNG, PDF; 5 MB; 5 berkas per catatan.
# Bila salah satu dikosongkan, upload lampiran tetap mati.
FINANCE_ATTACHMENT_MAX_BYTES=5242880
FINANCE_ATTACHMENT_MAX_FILES=5
FINANCE_ATTACHMENT_MIME_TYPES=image/jpeg,image/png,application/pdf
# Path absolut privat di luar folder public; kosong berarti storage/app/private/finance-v2.
# FINANCE_PRIVATE_ROOT=

# Kosong berarti fitur pencadangan dalam aplikasi mati. Isi dengan UUID publik akun pengelola yang menjadi operator.
FINANCE_RECOVERY_OPERATORS=
# FINANCE_RECOVERY_ROOT=

# Q08, nilai pilot: scripts/backup-mysql.sh harian lewat cron, retensi 14 hari (RETENTION_DAYS), RPO 24 jam, RTO 1 hari kerja.
# Cron `php artisan schedule:run` tiap menit menjalankan pembersihan token kedaluwarsa.

# TrustProxies: Nginx + PHP-FPM di mesin yang sama tidak butuh pengaturan. Bila ada proxy atau load balancer di depan
# (misalnya Cloudflare), daftarkan alamatnya lewat $middleware->trustProxies(at: [...]) di bootstrap/app.php.
# Jangan memakai '*' kecuali server hanya bisa dijangkau lewat proxy itu.

APP_NAME="Inofarm Jogja"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=inofarm_local
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
# FIN15: blank disables system-wide recovery capability. Explicit manager public UUIDs only.
FINANCE_RECOVERY_OPERATORS=
# Optional absolute private path OUTSIDE public; unset uses storage/app/recovery-private-v2.
# FINANCE_RECOVERY_ROOT=
# Isolated restore marker is supplied by the owned drill runner, never a production default.

digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
start [label="",shape="circle",width=".18",height=".18",fillcolor="#183E34",style="filled"];
end [label="",shape="doublecircle",width=".20",height=".20",fillcolor="#183E34",style="filled"];
select [label="Pilih GH → musim → kelompok varietas",];
input [label="Pilih kegiatan; isi aktual, bahan,\nsatuan, waktu dan catatan",];
fix [label="Perbaiki isian",];
review [label="Tinjau pesan dan versi server",];
context [label="Tampilkan jadwal / target dan HSS/HST",];
valid [label="Isian lengkap\ndan sah?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
draft [label="Simpan\nsebagai draf?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
savedraft [label="Simpan draf lokal\nTidak masuk laporan",];
local [label="Simpan UUID catatan + revisi\ndan operasi sinkronisasi secara atomik",];
online [label="Koneksi dan\nsesi tersedia?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
wait [label="Tampilkan menunggu sinkronisasi\nPertahankan catatan lokal",];
ack [label="Tandai tersinkron setelah ACK server",];
check [label="Periksa akses, musim terbuka,\nisi, idempotensi dan versi",];
accepted [label="Diterima /\nulangan yang sama?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
store [label="Simpan catatan + detail + audit\natau kembalikan hasil operasi sebelumnya",];
start -> select [label="",];
select -> context [label="",];
context -> merge_input [label="",];
input -> valid [label="",];
valid -> draft [label="Tidak",];
draft -> savedraft [label="Ya",];
savedraft -> end [label="",];
draft -> fix [label="Tidak",];
fix -> merge_input [label="",];
valid -> local [label="Ya",];
local -> online [label="",];
online -> wait [label="Tidak",];
wait -> end [label="Akhir interaksi; antrean tetap ada",];
online -> check [label="Ya",];
check -> accepted [label="",];
accepted -> store [label="Ya",];
store -> ack [label="",];
ack -> end [label="",];
accepted -> review [label="Tidak: ditolak / konflik",];
review -> end [label="Tindak lanjut AD-03",];
merge_input [label="",shape="diamond",width=".18",height=".18",fixedsize="true",style="filled",fillcolor="#DCECE6"];
merge_input -> input [label="",];
}
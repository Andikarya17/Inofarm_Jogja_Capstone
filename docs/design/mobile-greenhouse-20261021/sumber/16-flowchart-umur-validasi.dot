digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
start [label="",shape="circle",width=".18",height=".18",fillcolor="#183E34",style="filled"];
end [label="",shape="doublecircle",width=".20",height=".20",fillcolor="#183E34",style="filled"];
input [label="Ambil tanggal kegiatan, tanggal semai,\ntanggal pindah, jenis dan nilai aktual",];
error [label="Tampilkan kesalahan struktur / tanggal\nMinta perbaikan atau simpan draf",];
hss [label="HSS = selisih tanggal kegiatan\ndengan tanggal semai + 1",];
hst [label="HST = selisih tanggal kegiatan\ndengan tanggal pindah + 1",];
null [label="HST belum berlaku\nJangan isi nol sebagai data aktual",];
target [label="Ambil target berlaku pada tanggal / kelompok\nSimpan snapshot target dan versinya",];
unknown [label="Tandai belum dapat dibandingkan",];
warn [label="Tandai selisih terhadap target\nPertahankan nilai aktual",];
match [label="Tandai sesuai target yang tersedia",];
save [label="Simpan hasil, penanda dan asal target\nTidak menyatakan keberhasilan budidaya",];
valid [label="Tanggal dan nilai\nstruktural sah?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
trans [label="Sudah pindah tanam\npada tanggal kegiatan?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
exists [label="Target yang relevan\ntersedia?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
fit [label="Aktual sesuai\ntarget tersedia?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
start -> input [label="",];
input -> valid [label="",];
valid -> error [label="Tidak",];
error -> end [label="",];
valid -> hss [label="Ya",];
hss -> trans [label="",];
trans -> hst [label="Ya",];
trans -> null [label="Tidak",];
hst -> target [label="",];
null -> target [label="",];
target -> exists [label="",];
exists -> unknown [label="Tidak",];
exists -> fit [label="Ya",];
fit -> warn [label="Tidak",];
fit -> match [label="Ya",];
unknown -> save [label="",];
warn -> save [label="",];
match -> save [label="",];
save -> end [label="",];
}
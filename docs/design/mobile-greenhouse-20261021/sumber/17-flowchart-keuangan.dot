digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
start [label="",shape="circle",width=".18",height=".18",fillcolor="#183E34",style="filled"];
end [label="",shape="doublecircle",width=".20",height=".20",fillcolor="#183E34",style="filled"];
scope [label="Pilih cakupan, periode dan versi data",];
read [label="Ambil data sah tersinkron;\nkeluarkan draf dan pembatalan",];
cost [label="FC = beban tetap + penyusutan teralokasi\nVC = biaya variabel teralokasi\nTC = FC + VC",];
rev [label="TR = Σ(kg terjual × harga/kg)\nL = TR - TC; Q = Σ kg terjual",];
ratio [label="R/C = TR / TC\nB/C sederhana = L / TC",];
noratio [label="Rasio belum dapat dihitung",];
bep [label="P = TR / Q\nBEP kg = TC / P; BEP harga = TC / Q",];
nobep [label="BEP terkait belum dapat dihitung",];
cash [label="Skenario tahunan: I0 sekali pada t=0\nCFt = kas masuk - kas keluar\nPenyusutan bukan kas keluar",];
invest [label="NPV = -I0 + Σ CFt / (1+r)^t\nIRR numerik hanya bila hasil dapat ditafsirkan\nPP: kumulatif CF; DPP: kumulatif PV",];
noinvest [label="Tampilkan input yang belum lengkap",];
present [label="Tampilkan hasil per indikator, rumus, asumsi\nSementara untuk musim berjalan\nIRR tidak tersedia / modal belum kembali bila relevan",];
kind [label="Jenis\nevaluasi?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
tc [label="TC > 0 dan\ndata lengkap?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
qp [label="Q > 0, TR > 0\ndan data lengkap?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
ready [label="I0, horizon, diskonto\ndan CF lengkap?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
start -> scope [label="",];
scope -> read [label="",];
read -> kind [label="",];
kind -> cost [label="Musim",];
cost -> rev [label="",];
rev -> tc [label="",];
tc -> ratio [label="Ya",];
tc -> noratio [label="Tidak",];
ratio -> qp [label="",];
noratio -> qp [label="",];
qp -> bep [label="Ya",];
qp -> nobep [label="Tidak",];
bep -> present [label="",];
nobep -> present [label="",];
kind -> cash [label="Investasi",];
cash -> ready [label="",];
ready -> invest [label="Ya",];
ready -> noinvest [label="Tidak",];
invest -> present [label="",];
noinvest -> present [label="",];
present -> end [label="",];
}
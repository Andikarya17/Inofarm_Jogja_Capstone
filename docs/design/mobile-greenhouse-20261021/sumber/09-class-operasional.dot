digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
user [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Pengguna</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR><TR><TD ALIGN="LEFT">peran: Peran</TD></TR><TR><TD ALIGN="LEFT">aktif: Boolean</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">bolehMengakses(gh): Boolean</TD></TR></TABLE>>];
gh [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Greenhouse</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR><TR><TD ALIGN="LEFT">lokasi: String</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">tambahMusim(nama)</TD></TR></TABLE>>];
season [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>MusimTanam</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR><TR><TD ALIGN="LEFT">status: StatusMusim</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">tutup(alasan)</TD></TR><TR><TD ALIGN="LEFT">bukaKembali(alasan)</TD></TR></TABLE>>];
group [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>KelompokTanam</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR><TR><TD ALIGN="LEFT">tanggalSemai: Date</TD></TR><TR><TD ALIGN="LEFT">tanggalPindah: Date?</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">hss(tanggal): Integer</TD></TR><TR><TD ALIGN="LEFT">hst(tanggal): Integer?</TD></TR></TABLE>>];
var [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Varietas</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR></TABLE>>];
schedule [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Jadwal</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">jenis: JenisKegiatan</TD></TR><TR><TD ALIGN="LEFT">tanggalRencana: Date</TD></TR><TR><TD ALIGN="LEFT">targetPpm: Decimal?</TD></TR><TR><TD ALIGN="LEFT">phMin, phMax: Decimal?</TD></TR><TR><TD ALIGN="LEFT">stadia: String</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">ubahDenganVersi()</TD></TR></TABLE>>];
act [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Aktivitas</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">waktuKejadian: Instant</TD></TR><TR><TD ALIGN="LEFT">ppmAktual, phAktual: Decimal?</TD></TR><TR><TD ALIGN="LEFT">status: StatusKegiatan</TD></TR><TR><TD ALIGN="LEFT">versi: Integer</TD></TR><TR><TD ALIGN="LEFT">dibatalkan: Boolean</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">validasiStruktur()</TD></TR><TR><TD ALIGN="LEFT">bandingkanTarget(snapshot)</TD></TR><TR><TD ALIGN="LEFT">koreksi(alasan)</TD></TR></TABLE>>];
detail [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>DetailBahan</B></TD></TR><TR><TD ALIGN="LEFT">bahanId: UUID</TD></TR><TR><TD ALIGN="LEFT">jumlah: Decimal</TD></TR><TR><TD ALIGN="LEFT">satuanId: UUID</TD></TR><TR><TD ALIGN="LEFT">jenisLarutan: String?</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">validasiSatuan()</TD></TR></TABLE>>];
harvest [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Panen</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">tanggal: Date</TD></TR><TR><TD ALIGN="LEFT">versi: Integer</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">catatDetailGrade()</TD></TR></TABLE>>];
hd [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>DetailPanen</B></TD></TR><TR><TD ALIGN="LEFT">grade: String</TD></TR><TR><TD ALIGN="LEFT">jumlahBuah: Integer</TD></TR><TR><TD ALIGN="LEFT">beratKg: Decimal</TD></TR></TABLE>>];
user -> gh [label="0..* penugasan ↔ 0..*",dir="none"];
gh -> season [label="1 memiliki 0..*",dir="none"];
season -> group [label="1 memiliki 0..*",dir="none"];
var -> group [label="1 dipakai 0..*",dir="none"];
group -> schedule [label="1 memiliki 0..*",dir="none"];
group -> act [label="1 memiliki 0..*",dir="none"];
schedule -> act [label="0..1 acuan untuk 0..*",dir="none"];
user -> act [label="1 pencatat untuk 0..*",dir="none"];
act -> detail [label="1 terdiri dari 0..*",dir="none"];
group -> harvest [label="1 memiliki 0..*",dir="none"];
harvest -> hd [label="1 terdiri dari 1..*",dir="none"];
}
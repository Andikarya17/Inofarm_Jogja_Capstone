digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
start [label="",shape="circle",width=".18",height=".18",fillcolor="#183E34",style="filled"];
end [label="",shape="doublecircle",width=".20",height=".20",fillcolor="#183E34",style="filled"];
select [label="Buka detail catatan / konflik",];
closedmsg [label="Minta pengelola membuka kembali\nmusim dengan alasan",];
open [label="Pengelola membuka musim\nServer menyimpan audit",];
deny [label="Tampilkan akses ditolak;\ndata server tetap",];
edit [label="Bandingkan lokal dan server;\nisi koreksi atau alasan pembatalan",];
commit [label="Kirim perubahan + versi dasar terbaru\nServer cek ulang akses dan status musim",];
conflict [label="Tampilkan versi server terbaru\nTidak menimpa otomatis",];
save [label="Simpan revisi + audit dalam satu transaksi\nPembatalan tetap tersimpan, keluar dari total",];
report [label="Perbarui laporan versi baru\nLaporan terdahulu tetap dapat ditelusuri",];
closed [label="Musim\ntertutup?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
reopen [label="Pengelola\nmenyetujui buka?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
rights [label="Kewenangan\nmemadai?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
fresh [label="Versi cocok dan\nvalidasi lulus?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
start -> select [label="",];
select -> closed [label="",];
closed -> closedmsg [label="Ya",];
closedmsg -> reopen [label="",];
reopen -> open [label="Ya",];
reopen -> end [label="Tidak",];
open -> merge_rights [label="",];
closed -> merge_rights [label="Tidak",];
rights -> deny [label="Tidak",];
deny -> end [label="",];
rights -> merge_edit [label="Ya",];
edit -> commit [label="",];
commit -> fresh [label="",];
fresh -> conflict [label="Tidak",];
conflict -> merge_edit [label="Tinjau ulang",];
fresh -> save [label="Ya",];
save -> report [label="",];
report -> end [label="",];
merge_rights [label="",shape="diamond",width=".18",height=".18",fixedsize="true",style="filled",fillcolor="#DCECE6"];
merge_rights -> rights [label="",];
merge_edit [label="",shape="diamond",width=".18",height=".18",fixedsize="true",style="filled",fillcolor="#DCECE6"];
merge_edit -> edit [label="",];
}
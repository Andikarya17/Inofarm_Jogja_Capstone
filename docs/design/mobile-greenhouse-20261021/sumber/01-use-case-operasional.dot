h [label="UC-08\nLihat dan cari riwayat",shape="ellipse",style="filled"];
i [label="UC-09\nKoreksi catatan",shape="ellipse",style="filled"];
j [label="UC-10\nBatalkan catatan dengan alasan",shape="ellipse",style="filled"];
k [label="UC-11\nTutup / buka kembali musim",shape="ellipse",style="filled"];
l [label="UC-12\nTinjau konflik sinkronisasi",shape="ellipse",style="filled"];
}

digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
start [label="",shape="circle",width=".18",height=".18",fillcolor="#183E34",style="filled"];
end [label="",shape="doublecircle",width=".20",height=".20",fillcolor="#183E34",style="filled"];
choose [label="Pengelola memilih GH dan musim",];
data [label="Catat pengeluaran, alokasi biaya,\naset, atau penjualan lunas",];
validate [label="Server memeriksa akses dan data:\nalokasi, nilai uang, kuantitas panen, versi",];
fix [label="Tampilkan alasan; perbaiki input",];
save [label="Simpan transaksi dan audit secara atomik\nACK → tandai tersinkron",];
scope [label="Pilih evaluasi musim / skenario investasi",];
calc [label="Hitung dari data server sesuai cakupan\nPisahkan beban penyusutan dari arus kas",];
result [label="Tampilkan input, rumus, hasil, asumsi\ndan waktu / versi data",];
partial [label="Tampilkan hasil yang tersedia; indikator\nyang kekurangan data belum dapat dihitung",];
export [label="Ekspor PDF / CSV sesuai filter",];
ok [label="Input sah dan\nversi sesuai?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
complete [label="Data untuk tiap\nindikator lengkap?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
want [label="Ekspor?",shape="diamond",style="filled",fillcolor="#FFF4DF"];
start -> choose [label="",];
choose -> merge_data [label="",];
data -> validate [label="",];
validate -> ok [label="",];
ok -> fix [label="Tidak",];
fix -> merge_data [label="",];
ok -> save [label="Ya",];
save -> scope [label="",];
scope -> complete [label="",];
complete -> calc [label="Ya",];
complete -> partial [label="Tidak / sebagian",];
calc -> merge_result [label="",];
partial -> merge_result [label="",];
result -> want [label="",];
want -> export [label="Ya",];
export -> end [label="",];
want -> end [label="Tidak",];
merge_data [label="",shape="diamond",width=".18",height=".18",fixedsize="true",style="filled",fillcolor="#DCECE6"];
merge_data -> data [label="",];
merge_result [label="",shape="diamond",width=".18",height=".18",fixedsize="true",style="filled",fillcolor="#DCECE6"];
merge_result -> result [label="",];
}
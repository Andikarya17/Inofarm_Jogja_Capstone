digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.4", ranksep="0.55", fontname="Arial", fontsize=13, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#F1F7F5", color="#427568", fontname="Arial", fontsize=12, margin="0.16,0.10", penwidth=1.2];
edge [color="#526B65", fontname="Arial", fontsize=10, arrowsize=0.7];
expense [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Pengeluaran</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">tanggal: Date</TD></TR><TR><TD ALIGN="LEFT">nilai: Decimal</TD></TR><TR><TD ALIGN="LEFT">kategoriId: UUID</TD></TR><TR><TD ALIGN="LEFT">versi: Integer</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">alokasikan(musim,nilai)</TD></TR></TABLE>>];
alloc [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>AlokasiBiaya</B></TD></TR><TR><TD ALIGN="LEFT">musimId: UUID</TD></TR><TR><TD ALIGN="LEFT">nilai: Decimal</TD></TR><TR><TD ALIGN="LEFT">dasarAlokasi: String</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">cekSisaBiaya()</TD></TR></TABLE>>];
asset [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Aset</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">hargaPerolehan: Decimal</TD></TR><TR><TD ALIGN="LEFT">nilaiSisa: Decimal</TD></TR><TR><TD ALIGN="LEFT">umurTahun: Decimal</TD></TR><TR><TD ALIGN="LEFT">mulaiPakai: Date</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">penyusutanTahunan(): Decimal</TD></TR></TABLE>>];
dep [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>AlokasiPenyusutan</B></TD></TR><TR><TD ALIGN="LEFT">musimId: UUID</TD></TR><TR><TD ALIGN="LEFT">periodeMulai, akhir: Date</TD></TR><TR><TD ALIGN="LEFT">proporsi: Decimal</TD></TR><TR><TD ALIGN="LEFT">nilaiBeban: Decimal</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">cekBatasNilaiAset()</TD></TR></TABLE>>];
sale [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>Penjualan</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">musimId: UUID</TD></TR><TR><TD ALIGN="LEFT">tanggal: Date</TD></TR><TR><TD ALIGN="LEFT">status: Lunas</TD></TR><TR><TD ALIGN="LEFT">versi: Integer</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">total(): Decimal</TD></TR></TABLE>>];
sd [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>DetailPenjualan</B></TD></TR><TR><TD ALIGN="LEFT">detailPanenId: UUID</TD></TR><TR><TD ALIGN="LEFT">beratKg: Decimal</TD></TR><TR><TD ALIGN="LEFT">hargaPerKg: Decimal</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">subtotal(): Decimal</TD></TR></TABLE>>];
scenario [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>SkenarioInvestasi</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">nama: String</TD></TR><TR><TD ALIGN="LEFT">horizonTahun: Integer</TD></TR><TR><TD ALIGN="LEFT">diskontoTahunan: Decimal</TD></TR><TR><TD ALIGN="LEFT">investasiAwal: Decimal</TD></TR><TR><TD ALIGN="LEFT">versi: Integer</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">validasiKelengkapan()</TD></TR></TABLE>>];
cash [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>ArusKasTahunan</B></TD></TR><TR><TD ALIGN="LEFT">tahunKe: Integer</TD></TR><TR><TD ALIGN="LEFT">kasMasuk: Decimal</TD></TR><TR><TD ALIGN="LEFT">kasKeluar: Decimal</TD></TR><TR><TD ALIGN="LEFT">asal: Aktual/Proyeksi</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">arusKasBersih(): Decimal</TD></TR></TABLE>>];
service [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>LayananEvaluasi</B></TD></TR><TR><TD ALIGN="LEFT">presisi: Decimal</TD></TR><TR><TD BGCOLOR="#EAF3EF"><I>Operasi</I></TD></TR><TR><TD ALIGN="LEFT">evaluasiMusim(musim,versi)</TD></TR><TR><TD ALIGN="LEFT">evaluasiInvestasi(skenario)</TD></TR><TR><TD ALIGN="LEFT">ekspor(snapshot,format)</TD></TR></TABLE>>];
report [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#427568"><TR><TD BGCOLOR="#DCECE6"><B>SnapshotLaporan</B></TD></TR><TR><TD ALIGN="LEFT">id: UUID</TD></TR><TR><TD ALIGN="LEFT">filter: Object</TD></TR><TR><TD ALIGN="LEFT">versiSumber: Object</TD></TR><TR><TD ALIGN="LEFT">dibuatPada: Instant</TD></TR><TR><TD ALIGN="LEFT">hasil: Object</TD></TR><TR><TD ALIGN="LEFT">asumsi: Object</TD></TR></TABLE>>];
expense -> alloc [label="1 → 0..*",dir="none"];
asset -> dep [label="1 → 0..*",dir="none"];
sale -> sd [label="1 → 1..*",dir="none"];
scenario -> cash [label="1 → 0..*",dir="none"];
service -> alloc [label="«use»",style="dashed"];
service -> dep [label="«use»",style="dashed"];
service -> sale [label="«use»",style="dashed"];
service -> scenario [label="«use»",style="dashed"];
service -> report [label="menghasilkan",style="dashed"];
}
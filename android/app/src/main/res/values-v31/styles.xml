<resources>
    <!-- Android 12 and later: the system splash uses the forest canopy and the adaptive launcher icon. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/inofarm_forest</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/inofarm_forest</item>
        <item name="android:windowSplashScreenBackground">@color/inofarm_forest</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/inofarm_forest</item>
    </style>
</resources>

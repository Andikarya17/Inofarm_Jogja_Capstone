{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sync_epoch",
    "operation_id",
    "entity_id",
    "entity_type",
    "action",
    "base_version",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "sync_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_type": {
      "const": "investment_report"
    },
    "action": {
      "const": "create"
    },
    "base_version": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "review_note",
        "expected_scenario_version",
        "expected_sources_hash",
        "expected_formula_version"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "review_note": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 2000
        },
        "expected_scenario_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expected_sources_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_formula_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}

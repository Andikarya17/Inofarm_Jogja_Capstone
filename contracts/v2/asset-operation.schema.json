{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inofarm v2 asset operation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "sync_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_type": {
      "const": "asset"
    },
    "action": {
      "enum": [
        "create",
        "update",
        "cancel"
      ]
    },
    "base_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "sync_epoch",
    "operation_id",
    "entity_id",
    "entity_type",
    "action",
    "base_version",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "base_version": {
            "type": "null"
          },
          "payload": {
            "$ref": "#/$defs/create"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "update"
          }
        }
      },
      "then": {
        "properties": {
          "base_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "payload": {
            "$ref": "#/$defs/update"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "properties": {
          "base_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "payload": {
            "$ref": "#/$defs/cancel"
          }
        }
      }
    }
  ],
  "$defs": {
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expense_id",
        "name",
        "cost",
        "residual",
        "life_years",
        "in_service_date",
        "usage_basis"
      ],
      "properties": {
        "expense_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "pattern": "\\S"
        },
        "cost": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,2})?$"
        },
        "residual": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,2})?$"
        },
        "life_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "in_service_date": {
          "type": "string",
          "format": "date"
        },
        "usage_basis": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expense_id",
        "name",
        "cost",
        "residual",
        "life_years",
        "in_service_date",
        "usage_basis",
        "reason"
      ],
      "properties": {
        "expense_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "pattern": "\\S"
        },
        "cost": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,2})?$"
        },
        "residual": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,2})?$"
        },
        "life_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "in_service_date": {
          "type": "string",
          "format": "date"
        },
        "usage_basis": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    }
  }
}

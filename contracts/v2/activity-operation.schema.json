              },
              "work_state": {
                "const": "completed"
              },
              "materials": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "reason"
      ]
    }
  }

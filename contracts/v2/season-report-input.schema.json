{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Season report review input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season_id",
    "coverage",
    "known_pending_count",
    "requested_state",
    "review_note"
  ],
  "properties": {
    "season_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "costs",
        "sales"
      ],
      "properties": {
        "costs": {
          "enum": [
            "unknown",
            "partial",
            "complete"
          ]
        },
        "sales": {
          "enum": [
            "unknown",
            "partial",
            "complete"
          ]
        }
      }
    },
    "known_pending_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 2147483647
    },
    "requested_state": {
      "enum": [
        "provisional",
        "reviewed_final"
      ]
    },
    "review_note": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 2000
    }
  }
}

                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,2})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "initial_source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference",
                  "basis"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "actual",
                      "projection",
                      null
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "basis": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              },
              "discount_rate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,8})?|-0(?:\\.[0-9]{1,8})?)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payback_convention": {
                "enum": [
                  "interpolation",
                  "end_of_year",

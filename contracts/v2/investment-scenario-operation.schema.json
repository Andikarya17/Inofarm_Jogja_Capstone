    "base_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "base_version": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [

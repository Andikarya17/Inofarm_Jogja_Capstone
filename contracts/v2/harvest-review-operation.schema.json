{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harvest review operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sync_epoch",
    "operation_id",
    "entity_id",
    "entity_type",
    "action",
    "base_version",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "sync_epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_type": {
      "const": "harvest_review"
    },
    "action": {
      "const": "create"
    },
    "base_version": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harvest_id",
        "harvest_version",
        "decision"
      ],
      "properties": {
        "harvest_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "harvest_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "decision": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "if": {
        "properties": {
          "decision": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
